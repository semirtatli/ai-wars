# ──────────────────────────────────────────────
# AI Wars — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# All API keys are FREE tier — no payment method required.
# NONE of these keys are exposed to the client (no NEXT_PUBLIC_ prefix).
# ──────────────────────────────────────────────

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Models — https://github.com/settings/tokens (classic PAT with no scopes needed)
GITHUB_TOKEN=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Upstash Redis — https://console.upstash.com (create a Redis database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
